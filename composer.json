{
    "name": "jurager/teams",
    "description": "Laravel package to manage team functionality and operate with user permissions.",
    "keywords": [
        "laravel",
        "teams",
        "groups",
        "permissions",
        "abilities",
        "auth"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Yuri Gerassimov",
            "email": "jurager01@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^10.30|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.30|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.30|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.30|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.30|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.30|^11.0|^12.0|^13.0",
        "illuminate/bus": "^10.30|^11.0|^12.0|^13.0",
        "illuminate/mail": "^10.30|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.30|^11.0|^12.0|^13.0",
        "illuminate/validation": "^10.30|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.34|^3.0|^4.0",
        "heyosseus/sloppy": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Jurager\\Teams\\": "src/",
            "Jurager\\Teams\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jurager\\Teams\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "format:test": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jurager\\Teams\\TeamsServiceProvider"
            ],
            "aliases": {
                "Teams": "Jurager\\Teams\\Facades\\Teams"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
